# Copy to .env for local development. Values below are intentionally local-only.
COMPOSE_PROJECT_NAME=trade-workbench

POSTGRES_DB=trade_workbench
POSTGRES_USER=trade_workbench
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-dev-only-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=trade-workbench-documents
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1

# Optional Copilot provider. Keep actual credentials only in deployment secrets.
AI_PROVIDER=openai
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Replace these placeholders when connecting a Logto tenant.
OIDC_ISSUER=https://auth.example.invalid/oidc
OIDC_AUDIENCE=https://api.trade-workbench.local
OIDC_JWKS_URL=https://auth.example.invalid/oidc/jwks
# Pin to the verified issuer's signing algorithm; only RS256 or ES384.
OIDC_SIGNING_ALGORITHM=RS256

# Browser login. Tokens remain in SDK-encrypted HttpOnly cookies.
APP_BASE_URL=
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=
LOCAL_AUTH_ALLOW_HTTP=false
# Local identity Compose overlay only; never use this example in production.
LOGTO_DATABASE_PASSWORD=local-auth-only-change-me
